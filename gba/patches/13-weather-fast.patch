// GBA: patch 13-weather-fast. updateWeather's loop for rain, drizzle and acid: y += fl, x -= dx.
__attribute__((section(".iwram.text"), noinline, target("arm"))) static void wxMoveRain(int dc, int nWx, int fl, int dx) {
#pragma clang loop unroll(disable)
    for (int i = 0; i < nWx; i++) {
        int x = wxX[i] - dc, y = wxY[i] + fl;
        x -= dx;
        while (x < 0) x += WXR;
        while (x >= WXR) x -= WXR;
        if (y >= SH) { y = TOP; x = rnd(WXR); }
        if (y < TOP) { y = SH - 1; x = rnd(WXR); }
        wxX[i] = (uint8_t)x; wxY[i] = (uint8_t)y;
    }
}

// drawWeather's loop for rain, drizzle and acid: a falling streak, its colours from the table. The streak's two upper pixels
// share a column: its pointer and bit offset once. The bounds as pset's (the picture's, the hills' clip).
__attribute__((section(".iwram.text"), noinline, target("arm"))) static void wxDrawRain(int nWx, const uint8_t *f, int dx) {
    const uint8_t *const clip = gba_clipY;
    const uint32_t c1 = f[1] & 15u, c2 = f[2] & 15u;
#pragma clang loop unroll(disable)
    for (int i = 0; i < nWx; i++) {
        const int x = wxX[i], y = wxY[i];
        if (x >= SW) continue;
        if ((unsigned)y < SH && !(clip && y >= clip[x])) fb_px(x, y, c1);
        const int x2 = x + dx;
        if ((unsigned)x2 >= SW) continue;
        const int lim = clip ? clip[x2] : SH;                       // rows below it are not drawn
        volatile uint16_t *h = fb_pxh(x2) + (y - 1) * 2;
        const unsigned s = fb_pxs(x2);
        const uint16_t keep = (uint16_t)~(0xFu << s), val = (uint16_t)(c2 << s);
        if ((unsigned)(y - 1) < SH && y - 1 < lim) *h = (uint16_t)((*h & keep) | val);
        h -= 2;
        if ((unsigned)(y - 2) < SH && y - 2 < lim) *h = (uint16_t)((*h & keep) | val);
    }
}

