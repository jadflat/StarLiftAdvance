// GBA: patch 13-weather-fast. updateWeather's loop for rain, drizzle and acid: y += fl, x -= dx.
__attribute__((section(".iwram.text"), noinline, target("arm"))) static void wxMoveRain(int dc, int nWx, int fl, int dx) {
#pragma clang loop unroll(disable)
    for (int i = 0; i < nWx; i++) {
        int x = wxX[i] - dc, y = wxY[i] + fl;
        x -= dx;
        while (x < 0) x += WXR;
        while (x >= WXR) x -= WXR;
        if (y >= SH) { y = TOP; x = rnd(WXR); }
        if (y < TOP) { y = SH - 1; x = rnd(WXR); }
        wxX[i] = (uint8_t)x; wxY[i] = (uint8_t)y;
    }
}

// a pixel as pset puts it (the picture's bounds, the hills' clip)
static inline __attribute__((always_inline)) void wxPix(uint8_t *fb, const uint8_t *clip, int x, int y, uint8_t c) {
    if ((unsigned)x >= SW || (unsigned)y >= SH) return;
    if (clip && y >= clip[x]) return;
    uint8_t *b = fb + y * GFX_FB_STRIDE + (x >> 1);
    *b = (x & 1) ? (uint8_t)((*b & 0x0F) | (c << 4)) : (uint8_t)((*b & 0xF0) | c);
}

// drawWeather's loop for rain, drizzle and acid: a falling streak, its colours from the table
__attribute__((section(".iwram.text"), noinline, target("arm"))) static void wxDrawRain(int nWx, const uint8_t *f, int dx) {
    uint8_t *const fb = gfx_fb;
    const uint8_t *const clip = gba_clipY;
    const uint8_t c1 = f[1], c2 = f[2];
#pragma clang loop unroll(disable)
    for (int i = 0; i < nWx; i++) {
        const int x = wxX[i], y = wxY[i];
        if (x >= SW) continue;
        wxPix(fb, clip, x, y, c1); wxPix(fb, clip, x + dx, y - 1, c2); wxPix(fb, clip, x + dx, y - 2, c2);
    }
}

