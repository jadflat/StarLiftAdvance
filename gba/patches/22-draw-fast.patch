void gba_fillCols(int x, int y, int x1, int y1, uint8_t c) {     // GBA: patch 22-draw-fast; x < x1, y < y1, clipped
    const int h = y1 - y;
    uint32_t *const base = (uint32_t *)rowPtr(y);                   // group g, row y + i: base[g * 160 + i]
    const uint32_t cc = (uint32_t)(c & 0x0F) * 0x11111111u;
    const int g0 = x >> 3, g1 = (x1 - 1) >> 3;
    const uint32_t m0 = ~0u << ((x & 7) * 4), m1 = ~0u >> ((7 - ((x1 - 1) & 7)) * 4);
    for (int g = g0; g <= g1; g++) {
        uint32_t m = ~0u;
        if (g == g0) m &= m0;
        if (g == g1) m &= m1;
        uint32_t *q = base + g * 160;
        if (m == ~0u) {
            uint32_t a = cc, b = cc, d = cc, e = cc, f = cc, k = cc, l = cc;
            asm("" : "+r"(a), "+r"(b), "+r"(d), "+r"(e), "+r"(f), "+r"(k), "+r"(l));
            int n = h;
            for (; n >= 8; n -= 8)
                asm volatile("stmia %0!, {%1, %2, %3, %4, %5, %6, %7, %8}" : "+r"(q) : "r"(cc), "r"(a), "r"(b), "r"(d), "r"(e), "r"(f), "r"(k), "r"(l) : "memory");
            for (; n > 0; n--) *q++ = cc;
        } else {
            const uint32_t v = cc & m;
            for (int i = 0; i < h; i++) q[i] = (q[i] & ~m) | v;
        }
    }
}

