static uint8_t gbaLod, gbaLodHold;                               // GBA: patch 21-lod
static void gbaLodUpdate(uint32_t us) {
    const uint8_t want = GBA_LOD_NOTIME ? 0 : us > 27000 ? 2 : us > 22000 ? 1 : 0;
    if (want >= gbaLod && want) { gbaLod = want; gbaLodHold = 8; }
    else if (gbaLodHold) gbaLodHold--;
    else gbaLod = want;
}
static void gbaLodPredict() {                                    // from what is on screen, before drawing
    int s = 0;
    for (const auto &e : en) if (e.kind) s += 3;
    for (const auto &q : es) if (q.life) s += 2;
    for (const auto &q : shots) if (q.life) s += 1;
    for (const auto &q : pt) if (q.life) s++;
    const uint8_t want = s >= GBA_LOD_T2 ? 2 : s >= GBA_LOD_T1 ? 1 : 0;
    if (want > gbaLod) { gbaLod = want; gbaLodHold = 30; }
}
#define gbaLodV (GBA_LOD_VISIBLE ? gbaLod : 0)
