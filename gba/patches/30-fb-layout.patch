#define GFX_FB_BYTES     (GFX_FB_STRIDE * GFX_H)

/* Framebuffer layout (GBA build): COLUMN-MAJOR, straight in VRAM: gfx_fb is the back BG0 tile set (600 tiles, tile number
 * tx * 20 + ty for the 8x8 pixels at (8tx, 8ty)). A group of 8 pixels is a word, a group's 160 rows follow each other, so
 * pixel (x, y) is the nibble (x & 7) of word  (x >> 3) * 160 + y  (the byte  (x >> 3) * 640 + y * 4 + ((x >> 1) & 3)).
 * VRAM ignores byte stores: every store of a byte or a nibble goes through fb_st8 / fb_nib (a halfword read-modify-write).
 *   FB_ROW(y)        the row's first byte (group 0)     FB_X(row, x)    the byte of pixel x in a row pointer
 *   FB_ADDR(x, y)    the byte of pixel (x, y)           FB_WORDS        gfx_fb as words (8 pixels a word)
 *   FB_WY(y)         word index of row y, group 0       FB_WORD(g, y)   word index of 8-pixel group g of row y
 *   FB_GX(g)         word offset of group g (FB_WORDS + FB_WY(y) + FB_GX(g))
 *   FB_STEP_Y        bytes to the next row              FB_STEP_WY      words to the next row
 *   FB_BCOL(b)       the top byte of byte column b (two pixel columns)
 *   FB_STEP_X8       bytes to the next group of 8 pixels
 *   FB_NGROUPS       groups of 8 pixels in a row        FB_ROW_BYTES    bytes in a row: NOT contiguous now (FB_FILL_ROW)
 *   FB_ROWS_BYTES(n) bytes of a copy of n rows from the top (FB_ROWS_SAVE / FB_ROWS_LOAD) */
#define FB_ROW(y)          (gfx_fb + (y) * 4)
#define FB_X(row, x)       ((row) + ((x) >> 3) * 640 + (((x) >> 1) & 3))
#define FB_BCOL(b)         (gfx_fb + ((b) >> 2) * 640 + ((b) & 3))     /* top of byte column b (pixels 2b, 2b+1) */
#define FB_ADDR(x, y)      (FB_X(FB_ROW(y), (x)))
#define FB_WORDS           ((uint32_t *)gfx_fb)
#define FB_WY(y)           (y)
#define FB_GX(g)           ((g) * 160)
#define FB_WORD(g, y)      (FB_WY(y) + FB_GX(g))
#define FB_STEP_Y          4
#define FB_STEP_WY         1
#define FB_STEP_X8         640
#define FB_NGROUPS         30
#define FB_ROW_BYTES       GFX_FB_STRIDE
#define FB_ROWS_BYTES(n)   ((n) * GFX_FB_STRIDE)
