#define GFX_FB_BYTES     (GFX_FB_STRIDE * GFX_H)

/* Framebuffer layout (GBA build): LINEAR, row after row, two pixels a byte. Every access to gfx_fb goes through these.
 *   FB_ROW(y)        the first byte of row y            FB_X(row, x)    the byte of pixel x in a row pointer
 *   FB_ADDR(x, y)    the byte of pixel (x, y)           FB_WORDS        gfx_fb as words (8 pixels a word)
 *   FB_WY(y)         word index of row y's first word   FB_WORD(g, y)   word index of 8-pixel group g of row y
 *   FB_GX(g)         word offset of group g in a row (FB_WORDS + FB_WY(y) + FB_GX(g))
 *   FB_STEP_Y        bytes to the next row              FB_STEP_WY      words to the next row
 *   FB_BCOL(b)       the top byte of byte column b (two pixel columns)
 *   FB_STEP_X8       bytes to the next group of 8 pixels
 *   FB_NGROUPS       groups of 8 pixels in a row        FB_ROW_BYTES    bytes in a row (a whole-row fill or copy)
 *   FB_ROWS_BYTES(n) bytes of n rows from the top (a copy of the HUD) */
#define FB_ROW(y)          (gfx_fb + (y) * GFX_FB_STRIDE)
#define FB_X(row, x)       ((row) + ((x) >> 1))
#define FB_BCOL(b)         (gfx_fb + (b))     /* top of byte column b (pixels 2b, 2b+1) */
#define FB_ADDR(x, y)      (FB_X(FB_ROW(y), (x)))
#define FB_WORDS           ((uint32_t *)gfx_fb)
#define FB_WY(y)           ((y) * (GFX_FB_STRIDE / 4))
#define FB_GX(g)           (g)
#define FB_WORD(g, y)      (FB_WY(y) + FB_GX(g))
#define FB_STEP_Y          GFX_FB_STRIDE
#define FB_STEP_WY         (GFX_FB_STRIDE / 4)
#define FB_STEP_X8         4
#define FB_NGROUPS         (GFX_FB_STRIDE / 4)
#define FB_ROW_BYTES       GFX_FB_STRIDE
#define FB_ROWS_BYTES(n)   ((n) * GFX_FB_STRIDE)
