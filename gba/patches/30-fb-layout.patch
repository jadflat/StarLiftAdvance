extern uint8_t *gfx_fb;     /* GBA: the back tile set in VRAM (gfx_gba.cpp flips it at the VBlank; draw only after gfx_wait()) */
#include <stdint.h>
/* One byte into VRAM (it ignores byte stores): a halfword read-modify-write. */
static inline __attribute__((always_inline)) void fb_st8(uint8_t *p, unsigned v) {
    volatile uint16_t *const h = (volatile uint16_t *)((uintptr_t)p & ~(uintptr_t)1);
    const unsigned s = (unsigned)((uintptr_t)p & 1) << 3;
    *h = (uint16_t)((*h & ~(0xFFu << s)) | ((v & 0xFFu) << s));
}
/* Pixel x of its byte p (FB_X) in colour c. */
static inline __attribute__((always_inline)) void fb_nib(uint8_t *p, int x, unsigned c) {
    fb_st8(p, (x & 1) ? ((*p & 0x0Fu) | (c << 4)) : ((*p & 0xF0u) | c));
}
/* Pixels [x0, x1) (0 <= x0 < x1 <= 240) of the row FB_ROW(y) in colour c (0..15): a masked word store per group of 8. */
/* The same, only the pixels of the nibble pattern pat (0x0F0F0F0F: even x, 0xF0F0F0F0: odd x, ~0u: all). */
static inline __attribute__((always_inline)) void fb_spanM(uint8_t *row, int x0, int x1, unsigned c, uint32_t pat) {
    if (x1 <= x0) return;
    uint32_t *const w = (uint32_t *)row;
    const uint32_t cc = c * 0x11111111u;
    const int g0 = x0 >> 3, g1 = (x1 - 1) >> 3;
    const uint32_t m0 = (~0u << ((x0 & 7) * 4)) & pat, m1 = (~0u >> ((7 - ((x1 - 1) & 7)) * 4)) & pat;
    if (g0 == g1) { const uint32_t m = m0 & m1; w[g0 * 160] = (w[g0 * 160] & ~m) | (cc & m); return; }
    w[g0 * 160] = (w[g0 * 160] & ~m0) | (cc & m0);
    for (int g = g0 + 1; g < g1; g++) w[g * 160] = (w[g * 160] & ~pat) | (cc & pat);
    w[g1 * 160] = (w[g1 * 160] & ~m1) | (cc & m1);
}
static inline __attribute__((always_inline)) void fb_span(uint8_t *row, int x0, int x1, unsigned c) { fb_spanM(row, x0, x1, c, ~0u); }
/* A whole row in one byte value (two pixels of the same colour). */
static inline void gfx__fillRow(int y, unsigned b) {
    uint32_t *w = (uint32_t *)gfx_fb + y;
    const uint32_t v = (b & 0xFFu) * 0x01010101u;
    for (int g = 0; g < 30; g++, w += 160) *w = v;
}
#define FB_FILL_ROW(y, b)  gfx__fillRow((y), (b))
/* The top n rows into / out of a cache of FB_ROWS_BYTES(n) bytes (4-aligned). */
static inline void gfx__rowsSave(uint32_t *c, int n) {
    for (int g = 0; g < 30; g++) { const uint32_t *s = (const uint32_t *)gfx_fb + g * 160; for (int y = 0; y < n; y++) *c++ = s[y]; }
}
static inline void gfx__rowsLoad(const uint32_t *c, int n) {
    for (int g = 0; g < 30; g++) { uint32_t *d = (uint32_t *)gfx_fb + g * 160; for (int y = 0; y < n; y++) d[y] = *c++; }
}
#define FB_ROWS_SAVE(c, n) gfx__rowsSave((uint32_t *)(c), (n))
#define FB_ROWS_LOAD(c, n) gfx__rowsLoad((const uint32_t *)(c), (n))
